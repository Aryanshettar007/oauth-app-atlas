# Required
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
COMPOSIO_API_KEY=          # Composio dashboard → Settings → API keys (grant tool_execution for composio_search)

# Recommended
TAVILY_API_KEY=            # search fallback, free tier at tavily.com

# On Vercel: set automatically when a Blob store is connected; stores live-generated guides
# BLOB_READ_WRITE_TOKEN=

# Optional tuning
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# MAX_TURNS=10
# GENERATIONS_PER_HOUR=10
# RESEARCH_DEADLINE_MS=170000
